<section class="sl-cart sl-section">
  <h1>Your bag</h1>
  {% if cart.item_count == 0 %}<p>Your bag is empty.</p><a class="sl-button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}
  <form action="{{ routes.cart_url }}" method="post">
    <div class="sl-cart__items">{% for item in cart.items %}<div class="sl-cart__item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.image.alt }}</a>{% endif %}<div><a href="{{ item.url }}"><h2>{{ item.product.title | escape }}</h2></a><p>{{ item.variant.title | escape }}</p><a href="{{ item.url_to_remove }}">Remove</a></div><div><span>{{ item.final_line_price | money }}</span><label for="quantity-{{ forloop.index }}">Quantity</label><input id="quantity-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}"></div></div>{% endfor %}</div>
    <div class="sl-cart__summary"><button type="submit" name="update">Update bag</button><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="sl-add-to-cart" type="submit" name="checkout">Checkout</button></div>
  </form>{% endif %}
</section>
{% schema %}
{"name":"Cart","settings":[]}
{% endschema %}
