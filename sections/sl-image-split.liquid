<section class="sl-section sl-image-split"><h2>{{ section.settings.heading | escape }}</h2><div class="sl-image-split__grid">{% for block in section.blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="sl-image-split__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1300 | image_tag: loading: 'lazy', widths: '500, 900, 1300', alt: block.settings.image.alt }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.description != blank %}<p>{{ block.settings.description | escape }}</p>{% endif %}</a>{% endfor %}</div></section>
{% schema %}
{"name":"Two feature cards","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your favourite"}],"blocks":[{"type":"card","name":"Feature card","settings":[{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"title","label":"Title","default":"Explore the range"},{"type":"text","id":"description","label":"Description"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":2,"presets":[{"name":"Two feature cards","blocks":[{"type":"card"},{"type":"card"}]}]}
{% endschema %}
