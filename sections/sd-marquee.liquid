<section class="sd-marquee"><h2>{{ section.settings.heading | escape }}</h2><div class="sd-marquee__viewport"><div class="sd-marquee__track" aria-label="Explore the collection">{% for i in (1..3) %}{% for block in section.blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" {% if i != 1 %}aria-hidden="true" tabindex="-1"{% endif %} {{ block.shopify_attributes }}><span class="sd-marquee__drawing" aria-hidden="true">⌂</span>{{ block.settings.title | escape }}</a>{% endfor %}{% endfor %}</div></div></section>
{% schema %}
{"name":"Scrolling collections","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore Our Collection"}],"blocks":[{"type":"item","name":"Collection name","settings":[{"type":"text","id":"title","label":"Title"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Scrolling collections","blocks":[{"type":"item","settings":{"title":"Corner Sofas"}},{"type":"item","settings":{"title":"Modular Sofas"}},{"type":"item","settings":{"title":"Sofa Beds"}},{"type":"item","settings":{"title":"Armchairs"}}]}]}
{% endschema %}
