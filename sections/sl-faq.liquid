<section class="sl-section sl-faq"><h2>{{ section.settings.heading | escape }}</h2><div class="sl-faq__grid">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="sl-faq__answer">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"FAQs","settings":[{"type":"text","id":"heading","label":"Heading","default":"FAQs"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How does delivery work?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Add your answer here.</p>"}]}],"presets":[{"name":"FAQs","blocks":[{"type":"question"},{"type":"question"},{"type":"question"},{"type":"question"}]}]}
{% endschema %}
