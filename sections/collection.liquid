<section class="sl-collection sl-section">
  <nav class="sl-breadcrumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.all_products_collection_url }}">Shop</a><span>/</span><span>{{ collection.title | escape }}</span></nav>
  <h1>{{ collection.title | escape }}</h1>
  {% if collection.description != blank %}<div class="sl-collection__description">{{ collection.description }}</div>{% endif %}
  <div class="sl-collection__toolbar"><span>{{ collection.products_count }} products</span><form method="get"><label for="sort-by">Sort by</label><select id="sort-by" name="sort_by" onchange="this.form.submit()">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>
  {% paginate collection.products by 24 %}<div class="sl-collection__grid">{% for product in collection.products %}{% render 'sl-product-card', product: product %}{% endfor %}</div><div class="sl-pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}
</section>
{% schema %}
{"name":"Collection products","settings":[]}
{% endschema %}
