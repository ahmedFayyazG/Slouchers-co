{% comment %}
  Product detail page layout from the supplied reference, styled for Slouchers.
{% endcomment %}
{% assign cozey_product = product %}
{% assign chosen_variant = cozey_product.selected_or_first_available_variant %}
{% assign swatch_metaobject_type = section.settings.swatch_metaobject_type | default: 'swatches' %}
{% assign swatch_fabric_field = section.settings.swatch_fabric_field | default: 'first_name' %}
{% assign swatch_color_field = section.settings.swatch_color_field | default: 'second_name' %}
{% assign swatch_image_field = section.settings.swatch_image_field | default: 'image' %}
{% if cozey_product.featured_image %}
  {% assign active_image = cozey_product.featured_image | image_url: width: 1400 %}
{% else %}
  {% assign active_image = blank %}
{% endif %}
<section class="cz-page full-width" id="cz-product-{{ section.id }}">
  <div class="cz-crumb"><span>Shop</span><b>›</b><span>{{ cozey_product.type | default: 'Products' }}</span><b>›</b><span>{{ cozey_product.title }}</span></div>
  <main class="cz-main">
    <div class="cz-gallery">
      <div class="cz-thumbs" aria-label="Product images">
        {% if cozey_product.images.size > 0 %}
          {% for image in cozey_product.images limit: 4 %}
            {% assign thumb_image = image | image_url: width: 220 %}
            {% assign large_image = image | image_url: width: 1400 %}
            <button class="cz-thumb {% if forloop.first %}selected{% endif %}" data-image="{{ large_image }}"><img src="{{ thumb_image }}" width="160" height="160" alt="{{ image.alt | default: cozey_product.title | escape }}"></button>
          {% endfor %}
        {% else %}
          <button class="cz-thumb selected" data-image=""><span class="cz-thumb-placeholder"></span></button>
        {% endif %}
      </div>
      <div class="cz-hero-image">{% if active_image != blank %}<img class="cz-main-image" src="{{ active_image }}" width="1024" height="1024" alt="{{ cozey_product.title | default: 'Product image' | escape }}" fetchpriority="high">{% else %}<div class="cz-main-image cz-main-image--empty">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}<button class="cz-expand" aria-label="Expand image">⛶</button><button class="cz-prev" aria-label="Previous image">‹</button><button class="cz-next" aria-label="Next image">›</button><div class="cz-image-count">1 / {{ cozey_product.images.size | at_least: 1 | at_most: 4 }}</div></div>
    </div>
    <aside class="cz-info">
      <div class="cz-rating"><span>★★★★★</span><a href="#cz-reviews">(457 reviews)</a></div>
      <div class="cz-overline">{{ cozey_product.vendor | default: 'Slouchers & Co.' }}</div>
      <h1>{{ cozey_product.title }}</h1>
      <div class="cz-price"><strong class="cz-current-price">{% if chosen_variant %}{{ chosen_variant.price | money }}{% else %}From $2,995{% endif %}</strong><s class="cz-compare-price">{% if chosen_variant.compare_at_price > chosen_variant.price %}{{ chosen_variant.compare_at_price | money }}{% endif %}</s></div>
      <p class="cz-subcopy">{{ cozey_product.description | strip_html | truncate: 130 | default: 'Designed for everyday lounging, comfort, and real homes.' }}</p>
      <div class="cz-step"><div class="cz-step-title"><b>1. Seat Type</b><span>Select one</span></div><div class="cz-options cz-seat"><button>Regular</button><button>Storage</button><button class="active">Sleeper</button></div></div>
      <div class="cz-step"><div class="cz-step-title"><b>2. Style</b><span>Customize it</span></div><div class="cz-options cz-style"><button>Square</button><button class="active">Round</button></div><div class="cz-options cz-arms"><button class="active">2 Arms</button><button>Armless</button><button>Left Arm</button><button>Right Arm</button></div></div>
      <div class="cz-step cz-fabric-step"><div class="cz-step-title"><b>3. Fabric &amp; Color</b><span data-swatch-count>Loading fabrics</span></div><button class="cz-selected-fabric" type="button" data-swatch-drawer-open><span class="cz-swatch-dot is-missing"></span><span><b class="cz-fabric-name">Frost</b><small class="cz-fabric-type">Chenille</small></span><i>⌄</i></button>
        <div class="cz-colors" data-swatch-preview>
          <button class="cz-color active" type="button" data-color="Frost" data-fabric="Chenille"><span class="cz-swatch-dot is-missing"></span><small>Frost</small></button>
        </div>
        <div class="cz-swatch-actions"><button class="cz-care-link" type="button" data-swatch-drawer-open>View all fabrics <span>↗</span></button><button class="cz-care-link">View Materials &amp; Care Information <span>↗</span></button></div>
      </div>
      <div class="cz-step"><div class="cz-step-title"><b>4. Configuration</b><span>Select a layout</span></div><button class="cz-config-select"><span>3 Seater ・ 2 Arms</span><i>⌄</i></button><div class="cz-size-row"><button class="active">3 Seater</button><button>4 Seater</button><button>5 Seater</button></div><button class="cz-dimensions">View Full Dimensions <span>↗</span></button><a class="cz-modules" href="#">Shop Individual Modules <span>↗</span></a></div>
      <div class="cz-cta"><button class="cz-add" type="button" {% unless chosen_variant.available %}disabled{% endunless %}>{% if chosen_variant.available %}Add to cart{% else %}Sold out{% endif %} <span class="cz-cta-price">{% if chosen_variant %}{{ chosen_variant.price | money }}{% else %}$2,995{% endif %}</span></button><p>Free shipping · Ships in 2–3 weeks</p></div>
      {% form 'product', cozey_product, class: 'cz-product-form' %}
        <input type="hidden" name="id" value="{{ chosen_variant.id }}">
        <input type="hidden" name="quantity" value="1">
      {% endform %}
      <div class="cz-benefits"><div><span>↺</span><b>30-day free trial</b></div><div><span>♧</span><b>5-year warranty</b></div><div><span>◷</span><b>Affirm financing</b></div></div>
      <button class="cz-more">View more <span>⌄</span></button>
    </aside>
  </main>
  <section class="cz-accordions">{% assign accordions = 'Shipping,Returns,Materials,Assembly,Care,Dimensions,Key Features' | split: ',' %}{% for item in accordions %}<details><summary>{{ item }}<span>＋</span></summary><div class="cz-accordion-content">Thoughtfully designed for comfort, lasting quality, and easy everyday living. <a href="#">Learn more</a></div></details>{% endfor %}</section>
  <section class="cz-story"><div><span class="cz-overline">MADE FOR REAL LIFE</span><h2>A little more comfort. A lot more character.</h2><p>Thoughtfully made furniture for homes that feel like you.</p><a href="/pages/about">Discover Slouchers &amp; Co. →</a></div>{% if cozey_product.featured_image %}<img src="{{ cozey_product.featured_image | image_url: width: 1200 }}" width="1200" height="800" alt="{{ cozey_product.title | escape }}" loading="lazy">{% endif %}</section>
  <section class="cz-reviews" id="cz-reviews"><div class="cz-overline">CUSTOMER REVIEWS</div><h2>Loved in real homes</h2><div class="cz-review-score"><b>4.8</b><span>★★★★★</span><small>Based on 457 reviews</small></div><button class="cz-review-button">Leave a Review</button></section>
  <div class="cz-lightbox" aria-hidden="true"><button aria-label="Close">×</button><img src="{{ active_image }}" width="1024" height="1024" alt="Expanded sofa image"></div>
  <script type="application/json" data-product-swatches>
    [
      {%- assign first_swatch = true -%}
      {%- for option in cozey_product.options_with_values -%}
        {%- assign option_name = option.name | downcase -%}
        {%- if option_name contains 'color' or option_name contains 'colour' or option_name contains 'fabric' -%}
          {%- for value in option.values -%}
            {%- unless first_swatch -%},{%- endunless -%}
            {
              "fabric": {{ option.name | json }},
              "name": {{ value.name | json }},
              "hex": {%- if value.swatch.color != blank -%}{{ value.swatch.color | color_to_hex | json }}{%- else -%}""{%- endif -%},
              "image": {%- if value.swatch.image != blank -%}{{ value.swatch.image | image_url: width: 160 | json }}{%- else -%}""{%- endif -%}
            }
            {%- assign first_swatch = false -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-shopify-swatches>
    [
      {%- assign first_db_swatch = true -%}
      {%- assign swatch_entries = metaobjects[swatch_metaobject_type].values -%}
      {%- if swatch_entries == blank -%}
        {%- assign swatch_entries = metaobjects.swatch.values -%}
      {%- endif -%}
      {%- if swatch_entries == blank -%}
        {%- assign swatch_entries = metaobjects.fabric_swatch.values -%}
      {%- endif -%}
      {%- if swatch_entries == blank -%}
        {%- assign swatch_entries = metaobjects.fabric_swatches.values -%}
      {%- endif -%}
      {%- if swatch_entries == blank -%}
        {%- assign swatch_entries = metaobjects.fabric.values -%}
      {%- endif -%}
      {%- if swatch_entries == blank -%}
        {%- assign swatch_entries = metaobjects.fabrics.values -%}
      {%- endif -%}
      {%- paginate swatch_entries by 250 -%}
        {%- for entry in swatch_entries -%}
          {%- liquid
            assign fabric_value = entry[swatch_fabric_field].value
            if fabric_value == blank
              assign fabric_value = entry.fabric.value
            endif
            if fabric_value == blank
              assign fabric_value = entry.first_name.value
            endif
            if fabric_value == blank
              assign fabric_value = entry.name.value
            endif
            if fabric_value == blank
              assign fabric_value = entry.title.value
            endif

            assign color_value = entry[swatch_color_field].value
            if color_value == blank
              assign color_value = entry.color.value
            endif
            if color_value == blank
              assign color_value = entry.colour.value
            endif
            if color_value == blank
              assign color_value = entry.second_name.value
            endif
            if color_value == blank
              assign color_value = entry.color_name.value
            endif
            if color_value == blank
              assign color_value = entry.colour_name.value
            endif

            assign image_value = entry[swatch_image_field].value
            if image_value == blank
              assign image_value = entry.image.value
            endif
            if image_value == blank
              assign image_value = entry.swatch_image.value
            endif
            if image_value == blank
              assign image_value = entry.swatch.value
            endif
            if image_value == blank
              assign image_value = entry.photo.value
            endif
            if image_value == blank
              assign image_value = entry.file.value
            endif
            assign image_url_value = entry.image_url.value
            if image_url_value == blank
              assign image_url_value = entry.url.value
            endif
          -%}
          {%- if fabric_value != blank and color_value != blank -%}
            {%- unless first_db_swatch -%},{%- endunless -%}
            {
              "fabric": {{ fabric_value | json }},
              "name": {{ color_value | json }},
              "hex": "",
              "image": {%- if image_value != blank -%}{{ image_value | image_url: width: 240 | json }}{%- elsif image_url_value != blank -%}{{ image_url_value | json }}{%- else -%}""{%- endif -%}
            }
            {%- assign first_db_swatch = false -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endpaginate -%}
    ]
  </script>
</section>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
