<script>
(() => {
  const root = document.getElementById('cz-product-{{ section.id }}');
  if (!root) return;

  const main = root.querySelector('.cz-main-image');
  const thumbs = [...root.querySelectorAll('.cz-thumb')];
  const count = root.querySelector('.cz-image-count');
  const lightbox = root.querySelector('.cz-lightbox');
  let index = 0;

  function show(i) {
    index = (i + thumbs.length) % thumbs.length;
    main.src = thumbs[index].dataset.image;
    lightbox.querySelector('img').src = main.src;
    thumbs.forEach((thumb, n) => thumb.classList.toggle('selected', n === index));
    count.textContent = `${index + 1} / ${thumbs.length}`;
  }

  thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => show(i)));
  root.querySelector('.cz-prev').addEventListener('click', () => show(index - 1));
  root.querySelector('.cz-next').addEventListener('click', () => show(index + 1));
  root.querySelector('.cz-expand').addEventListener('click', () => lightbox.classList.add('open'));
  lightbox.querySelector('button').addEventListener('click', () => lightbox.classList.remove('open'));
  lightbox.addEventListener('click', (event) => {
    if (event.target.classList.contains('cz-lightbox')) event.currentTarget.classList.remove('open');
  });

  root.querySelectorAll('.cz-options button,.cz-size-row button').forEach((button) => {
    button.addEventListener('click', () => {
      button.parentElement.querySelectorAll('button').forEach((item) => item.classList.remove('active'));
      button.classList.add('active');
    });
  });

  const swatchPreview = root.querySelector('[data-swatch-preview]');
  const swatchCount = root.querySelector('[data-swatch-count]');
  const selectedDot = root.querySelector('.cz-selected-fabric .cz-swatch-dot');
  const selectedName = root.querySelector('.cz-fabric-name');
  const selectedType = root.querySelector('.cz-fabric-type');
  const swatchUrl = '{{ 'swatches.json' | asset_url }}';

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    })[char]);
  }

  function getProductSwatches() {
    const source = root.querySelector('[data-product-swatches]');
    if (!source) return [];
    try {
      return JSON.parse(source.textContent).filter((swatch) => swatch.name);
    } catch (error) {
      return [];
    }
  }

  function getDatabaseSwatches() {
    const source = root.querySelector('[data-shopify-swatches]');
    if (!source) return [];
    try {
      return JSON.parse(source.textContent).filter((swatch) => swatch.fabric && swatch.name);
    } catch (error) {
      return [];
    }
  }

  function flattenSwatches(data) {
    if (!data || !Array.isArray(data.swatches)) return [];
    return data.swatches.flatMap((group) => {
      const fabric = group.type || 'Fabric';
      return (group.colors || []).map((color) => ({
        fabric,
        name: color.name,
        hex: color.hex,
        image: color.image || color.image_url || color.src || color.url || color.preview_image || color.file || ''
      }));
    });
  }

  function allSwatches(data) {
    const seen = new Set();
    const databaseSwatches = getDatabaseSwatches();
    const sources = databaseSwatches.length ? databaseSwatches : [...getProductSwatches(), ...flattenSwatches(data)];
    return sources.filter((swatch) => {
      const key = `${swatch.fabric}::${swatch.name}`;
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }

  function selectSwatch(swatch) {
    selectedName.textContent = swatch.name;
    selectedType.textContent = swatch.fabric;
    selectedDot.classList.toggle('has-image', Boolean(swatch.image));
    selectedDot.classList.toggle('is-missing', !swatch.image);
    if (swatch.image) {
      selectedDot.style.setProperty('--swatch-image', `url("${swatch.image}")`);
    } else {
      selectedDot.style.removeProperty('--swatch-image');
    }
    root.querySelectorAll('.cz-color').forEach((item) => {
      item.classList.toggle('active', item.dataset.color === swatch.name && item.dataset.fabric === swatch.fabric);
    });
  }

  function renderPreview(data) {
    const swatches = allSwatches(data);
    if (!swatches.length) return;
    window.SlouchersInlineSwatches = getProductSwatches();
    window.SlouchersDatabaseSwatches = getDatabaseSwatches();
    swatchPreview.removeAttribute('data-loading');
    swatchCount.textContent = `${swatches.length} fabrics available`;
    swatchPreview.innerHTML = swatches.slice(0, 8).map((swatch, index) => `
      <button class="cz-color ${index === 0 ? 'active' : ''}" type="button" data-color="${escapeHtml(swatch.name)}" data-fabric="${escapeHtml(swatch.fabric)}" data-image="${escapeHtml(swatch.image)}" title="${escapeHtml(swatch.fabric)} - ${escapeHtml(swatch.name)}">
        <span class="cz-swatch-dot ${swatch.image ? 'has-image' : 'is-missing'}"></span>
        <small>${escapeHtml(swatch.name)}</small>
      </button>
    `).join('');
    swatchPreview.querySelectorAll('.cz-color').forEach((button) => {
      const image = button.dataset.image;
      if (image) button.querySelector('.cz-swatch-dot').style.setProperty('--swatch-image', `url("${image}")`);
    });
    swatchPreview.querySelectorAll('.cz-color').forEach((button, index) => {
      button.addEventListener('click', () => selectSwatch(swatches[index]));
    });
    selectSwatch(swatches[0]);
  }

  async function loadSwatches() {
    window.SlouchersInlineSwatches = getProductSwatches();
    window.SlouchersDatabaseSwatches = getDatabaseSwatches();
    swatchPreview.setAttribute('data-loading', 'true');
    if (window.SlouchersSwatchesData) {
      renderPreview(window.SlouchersSwatchesData);
      return window.SlouchersSwatchesData;
    }
    if (!window.SlouchersSwatchesPromise) {
      window.SlouchersSwatchesPromise = fetch(swatchUrl).then((response) => response.json()).then((data) => {
        window.SlouchersSwatchesData = data;
        window.swatchesData = data;
        return data;
      });
    }
    const data = await window.SlouchersSwatchesPromise;
    renderPreview(data);
    return data;
  }

  root.querySelectorAll('[data-swatch-drawer-open]').forEach((button) => {
    button.addEventListener('click', () => {
      if (window.openSwatchModal) {
        window.openSwatchModal();
      }
    });
  });

  window.addEventListener('slouchers:swatch-selected', (event) => {
    if (event.detail) selectSwatch(event.detail);
  });

  loadSwatches().catch(() => {
    swatchPreview.removeAttribute('data-loading');
    swatchCount.textContent = 'Fabrics unavailable';
  });

  root.querySelector('.cz-add').addEventListener('click', () => {
    const form = root.querySelector('form[action="/cart/add"]');
    if (form) {
      form.requestSubmit();
      return;
    }
    location.href = '/collections/all';
  });
})();
</script>
