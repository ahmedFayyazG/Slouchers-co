nd:#674b3c}.harbor-blue,.cerulean{background:#526b80}.bordeaux{background:#754854}.cobblestone{background:#aaa69e}.carbon,.nightfall{background:#35383a}.mocha{background:#8e7866}.lemon-zest{background:#d1c367}.ash{background:#a9aaa7}.tangerine{background:#d77c45}.cz-care-link,.cz-dimensions{border:0;background:none;padding:0;text-decoration:underline;font-size:13px;color:#111}.cz-config-select{height:47px;font-size:13px}.cz-size-row{display:flex;gap:8px;margin-top:9px}.cz-size-row button{flex:1;padding:0 5px}.cz-dimensions{display:block;margin-top:11px}.cz-modules{display:inline-block;margin-top:12px;font-size:13px;text-decoration:underline!important}.cz-add{width:100%;height:54px;border:0;background:#111;color:#fff!important;padding:0 18px;display:flex;align-items:center;justify-content:space-between;font-weight:700}.cz-add:disabled{opacity:.45}.cz-cta p{text-align:center;font-size:12px;color:#6e6e6e;margin:8px 0 14px}.cz-benefits{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);padding:16px 0;gap:8px}.cz-benefits div{background:var(--sd-peach);padding:12px;display:flex;flex-direction:column;align-items:flex-start;gap:14px;text-align:left}.cz-benefits span{font-size:20px}.cz-benefits b{font-size:12px;font-weight:700;line-height:1.1}.cz-more{width:100%;border:0;background:none;padding:14px 0;text-align:center;font-size:13px}.cz-accordions{max-width:1540px;margin:0 auto;padding:0 24px 45px}.cz-accordions details{border-top:1px solid var(--line)}.cz-accordions details:last-child{border-bottom:1px solid var(--line)}.cz-accordions summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;padding:18px 2px;font-size:17px;font-weight:700}.cz-accordions summary::-webkit-details-marker{display:none}.cz-accordions summary span{font-size:19px;font-weight:400}.cz-accordion-content{padding:0 2px 18px;color:#555;font-size:15px;line-height:1.35}.cz-story{display:grid;grid-template-columns: