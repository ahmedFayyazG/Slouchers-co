<section class="sl-hero full-width">
  <div class="sl-hero__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', alt: section.settings.image.alt }}{% else %}<div class="sl-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}</div>
  <div class="sl-hero__shade"></div>
  <div class="sl-hero__content"><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.subheading | escape }}</p><a class="sl-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></div>
  {% if section.settings.corner_text != blank %}<div class="sl-hero__corner">{{ section.settings.corner_text | escape }}</div>{% endif %}
</section>
{% schema %}
{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Hero photograph"},{"type":"text","id":"heading","label":"Heading","default":"Home, at last."},{"type":"text","id":"subheading","label":"Supporting text","default":"Beautifully made sofas for every kind of home."},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"corner_text","label":"Bottom right note","default":"Sit back. Stay awhile."}],"presets":[{"name":"Editorial hero"}]}
{% endschema %}
