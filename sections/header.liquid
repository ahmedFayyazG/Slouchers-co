<div class="sl-announcement">{{ section.settings.announcement | escape }}</div>
<header class="sl-header">
  <a class="sl-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">SLOUCHERS<span>&amp;CO.</span></a>
  <nav class="sl-desktop-nav" aria-label="Primary navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% if link.links != blank %}
          <details class="sl-nav-dropdown"><summary>{{ link.title | escape }}</summary><div class="sl-nav-dropdown__panel">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}</div></details>
        {% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}
      {% endfor %}
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">New arrivals</a>
      <details class="sl-nav-dropdown"><summary>Products</summary><div class="sl-nav-dropdown__panel"><a href="{{ routes.all_products_collection_url }}">All sofas</a><a href="{{ routes.collections_url }}/modular-sofas">Modular sofas</a><a href="{{ routes.collections_url }}/corner-sofas">Corner sofas</a><a href="{{ routes.collections_url }}/sofa-beds">Sofa beds</a></div></details>
      <a href="/pages/about-us">About</a>
    {% endif %}
  </nav>
  <div class="sl-header-actions"><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></div>
  <details class="sl-mobile-menu"><summary aria-label="Open menu">☰</summary><nav aria-label="Mobile navigation"><a href="{{ routes.all_products_collection_url }}">Shop all</a>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}<a href="/pages/about-us">About</a><a href="{{ routes.search_url }}">Search</a></nav></details>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"MADE FOR LIVING. MADE TO LAST."},{"type":"link_list","id":"menu","label":"Navigation menu"}]}
{% endschema %}
