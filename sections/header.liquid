<div class="sd-site-top" data-site-top>
  <div class="sd-announcement"><span>{{ section.settings.announcement | escape }}</span><a href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}">{{ section.settings.announcement_cta | escape }}</a></div>
  <header class="sd-header" data-sd-header>
    <div class="sd-header__bar">
      <a class="sd-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">slouchers<span>&amp;co</span></a>
      <nav class="sd-nav" aria-label="Main navigation">
        <a href="{{ routes.all_products_collection_url }}">Best Sellers</a>
        <button type="button" data-mega-trigger="sofas" aria-expanded="false" aria-controls="sd-mega-sofas">Shop Sofas by</button>
        <a href="{{ routes.all_products_collection_url }}?type=Footstools">Footstools</a>
        <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New Arrival</a>
        <a href="{{ routes.collections_url }}">Shop all</a>
      </nav>
      <div class="sd-header__actions">
        <a href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
        <a class="sd-account" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3.5"/><path d="M4.5 21c0-4.4 3-7 7.5-7s7.5 2.6 7.5 7"/></svg></a>
        <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h2l2.5 12.5h12L22 7H5"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{% if cart.item_count > 0 %}<small>{{ cart.item_count }}</small>{% endif %}</a>
        <button class="sd-mobile-toggle" type="button" data-mobile-trigger aria-expanded="false" aria-controls="sd-mobile-nav" aria-label="Open menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h20M2 12h20M2 18h20"/></svg></button>
      </div>
    </div>
    <div class="sd-mega" id="sd-mega-sofas" data-mega-panel="sofas" hidden>
      <div class="sd-mega__lead"><a href="{{ routes.all_products_collection_url }}">Sofas &amp; Sectionals</a><a href="{{ routes.all_products_collection_url }}">Corner Sofas</a><a href="{{ routes.all_products_collection_url }}">Modular Sofas</a></div>
      <div class="sd-mega__categories"><a href="{{ routes.all_products_collection_url }}">Chaise Sofas</a><a href="{{ routes.all_products_collection_url }}">Sofa Beds</a><a href="{{ routes.all_products_collection_url }}">Armchairs</a></div>
      <div class="sd-mega__links"><a href="{{ routes.collections_url }}/slouchers">Shop All</a>{% for link in section.settings.sofas_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}{% endfor %}</div>
      <a class="sd-mega__feature" href="{{ routes.collections_url }}/slouchers">Find your favourite sofa <span>↗</span></a>
    </div>
    <nav class="sd-mobile-nav" id="sd-mobile-nav" aria-label="Mobile navigation" hidden>
      <a href="{{ routes.all_products_collection_url }}">Best Sellers</a>
      <details><summary>Shop Sofas by</summary><a href="{{ routes.all_products_collection_url }}">Sofas &amp; Sectionals</a><a href="{{ routes.all_products_collection_url }}">Corner Sofas</a><a href="{{ routes.all_products_collection_url }}">Modular Sofas</a><a href="{{ routes.all_products_collection_url }}">Chaise Sofas</a>{% for link in section.settings.sofas_menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</details>
      <a href="{{ routes.all_products_collection_url }}?type=Footstools">Footstools</a>
      <a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New Arrival</a>
      <a href="{{ routes.collections_url }}">Shop all</a>
      <a href="{{ routes.search_url }}">Search</a>
    </nav>
  </header>
</div>
{% schema %}
{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Beautiful furniture for real life."},{"type":"text","id":"announcement_cta","label":"Announcement link text","default":"Shop Now"},{"type":"url","id":"announcement_link","label":"Announcement destination"},{"type":"link_list","id":"sofas_menu","label":"Shop Sofas by menu"}]}
{% endschema %}
