{% schema %}
{"name":"Header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Beautiful furniture for real life."},{"type":"text","id":"announcement_cta","label":"Announcement link text","default":"Shop Now"},{"type":"url","id":"announcement_link","label":"Announcement destination"},{"type":"link_list","id":"sofas_menu","label":"Shop Sofas by menu"}]}
{% endschema %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabBtns = document.querySelectorAll('.sd-mega__tab-btn');
  let swatchesData = null;

  // Load swatches
  async function loadSwatches() {
    try {
      if (window.SlouchersSwatchesData) {
        swatchesData = window.SlouchersSwatchesData;
      } else {
        if (!window.SlouchersSwatchesPromise) {
          window.SlouchersSwatchesPromise = fetch('{{ 'swatches.json' | asset_url }}').then(response => response.json());
        }
        swatchesData = await window.SlouchersSwatchesPromise;
        window.SlouchersSwatchesData = swatchesData;
      }
      window.swatchesData = swatchesData;
      renderSwatches();
    } catch (error) {
      console.error('Error loading swatches:', error);
    }
  }

  function renderSwatches() {
    const container = document.getElementById('fabrics-container');
    if (!swatchesData || !swatchesData.swatches) return;

    container.innerHTML = swatchesData.swatches.map(fabricType => `
      <div class="sd-mega__fabric-card">
        <div class="sd-mega__fabric-samples">
          ${fabricType.colors.map(color => {
            const image = color.image || color.image_url || color.src || color.url || color.preview_image || color.file || '';
            return `<div class="${image ? 'has-image' : 'is-missing'}" ${image ? `style="background-image:url('${image}')"` : ''} title="${color.name}">${image ? '' : 'Image needed'}</div>`;
          }).join('')}
        </div>
        <p>${fabricType.type}</p>
      </div>
    `).join('');
  }

  // Tab switching
  tabBtns.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const tabName = this.getAttribute('data-tab');

      // Remove active state from all buttons
      tabBtns.forEach(b => b.removeAttribute('data-active'));
      // Set active state on clicked button
      this.setAttribute('data-active', 'true');

      // Hide all tab contents
      document.querySelectorAll('.sd-mega__tab-content').forEach(content => {
        content.style.display = 'none';
      });
      // Show selected content
      document.querySelector(`[data-tab-content="${tabName}"]`).style.display = 'grid';

      // Hide all featured sections
      document.querySelectorAll('.sd-mega__featured').forEach(featured => {
        featured.style.display = 'none';
      });
      // Show corresponding featured section
      document.getElementById(`featured-${tabName}`).style.display = 'flex';

      // Load swatches when fabric tab is clicked
      if (tabName === 'fabric' && !swatchesData) {
        loadSwatches();
      }
    });
  });

  loadSwatches();
});
</script>
