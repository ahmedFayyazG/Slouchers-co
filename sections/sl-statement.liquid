<section class="sl-statement sl-section"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.link_label != blank %}<a class="sl-under-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</section>
{% schema %}
{"name":"Large statement","settings":[{"type":"text","id":"heading","label":"Heading","default":"It feels like home."},{"type":"text","id":"link_label","label":"Link label","default":"Discover Slouchers & Co."},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Large statement"}]}
{% endschema %}
