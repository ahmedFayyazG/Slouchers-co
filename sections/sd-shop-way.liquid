{% assign furniture_titles = 'Best Sellers|Sofas & Sectionals|Sideboards|Beds|Stools|Cabinets|Dining Tables|Storage Beds|Lounge Chairs|Side Tables|Media Units|Benches|Dining Chairs|Coffee Tables|Outdoor|Dressers' | split: '|' %}
{% assign furniture_images = 'reference-category-01.jpg|reference-category-02.jpg|reference-category-03.jpg|reference-category-04.jpg|reference-category-05.jpg|reference-category-06.jpg|reference-category-07.jpg|reference-category-08.jpg|reference-category-09.jpg|reference-category-10.jpg|reference-category-11.jpg|reference-category-12.jpg|reference-category-13.jpg|reference-category-14.jpg|reference-category-15.jpg|reference-category-16.jpg' | split: '|' %}
{% assign room_titles = 'Living Room|Outdoor|Office|Bedroom|Dining Room|Entryway' | split: '|' %}
{% assign room_images = 'reference-room-01.jpg|reference-room-02.jpg|reference-room-03.jpg|reference-room-04.jpg|reference-room-05.jpg|reference-room-06.jpg' | split: '|' %}
<section class="sd-shop-way" id="shop-your-way">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="sd-shop-way__tabs" role="tablist" aria-label="Shop your way">
    <button type="button" id="sd-tab-furniture" role="tab" aria-selected="true" aria-controls="sd-panel-furniture" data-shop-tab="furniture">Furniture</button>
    <button type="button" id="sd-tab-rooms" role="tab" aria-selected="false" aria-controls="sd-panel-rooms" data-shop-tab="rooms">Rooms</button>
  </div>
  <div class="sd-shop-way__grid" id="sd-panel-furniture" data-shop-panel="furniture" role="tabpanel" aria-labelledby="sd-tab-furniture">
    {% for title in furniture_titles %}
      {% assign img = furniture_images[forloop.index0] %}
      <a class="sd-shop-way__item" href="{{ routes.collections_url }}/slouchers"><div class="sd-shop-way__image"><img src="{{ img | asset_url }}" alt="" loading="lazy" width="700" height="438"></div><span>{{ title | escape }}</span></a>
    {% endfor %}
  </div>
  <div class="sd-shop-way__grid sd-shop-way__grid--rooms" id="sd-panel-rooms" data-shop-panel="rooms" role="tabpanel" aria-labelledby="sd-tab-rooms" hidden>
    {% for title in room_titles %}
      {% assign img = room_images[forloop.index0] %}
      <a class="sd-shop-way__item" href="{{ routes.collections_url }}/slouchers"><div class="sd-shop-way__image"><img src="{{ img | asset_url }}" alt="" loading="lazy" width="1000" height="800"></div><span>{{ title | escape }}</span></a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Shop your way","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop Your Way"}],"presets":[{"name":"Shop your way"}]}
{% endschema %}
