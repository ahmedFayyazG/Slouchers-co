<section class="sd-testimonials"><div class="sd-testimonials__intro"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p></div><div class="sd-testimonials__cards">{% for block in section.blocks %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="sd-testimonials__card" {{ block.shopify_attributes }}><div class="sd-testimonials__image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ 'reference-review.jpg' | asset_url }}" loading="lazy" width="1100" height="800" alt="A furnished living room">{% endif %}</div><div class="sd-testimonials__quote"><p>{{ block.settings.quote | escape }}</p><small>— {{ block.settings.author | escape }}</small><span class="sd-outline-button">{{ block.settings.link_label | escape }}</span></div></a>{% endfor %}</div></section>
{% schema %}
{"name":"Customer stories","settings":[{"type":"text","id":"heading","label":"Heading","default":"In Your Words"},{"type":"text","id":"body","label":"Description","default":"The moments you make at home are what matter most."}],"blocks":[{"type":"story","name":"Story","settings":[{"type":"image_picker","id":"image","label":"Photograph"},{"type":"textarea","id":"quote","label":"Customer quote"},{"type":"text","id":"author","label":"Author"},{"type":"text","id":"link_label","label":"Link label","default":"Shop the collection"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Customer stories","blocks":[{"type":"story","settings":{"quote":"Room to relax, stretch out and stay a little longer.","author":"SLOUCHERS & CO."}}]}]}
{% endschema %}
