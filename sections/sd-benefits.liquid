<section class="sd-benefits sd-reveal"><div class="sd-benefits__lead">{{ section.settings.heading | escape }}</div><div class="sd-benefits__grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><span class="sd-benefits__icon" aria-hidden="true">{% case forloop.index %}{% when 1 %}↗{% when 2 %}✳{% else %}♡{% endcase %}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>{% endfor %}</div></section>
{% schema %}
{"name":"Service benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"We make finding your favourite seat simple."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Description"}]}],"presets":[{"name":"Service benefits","blocks":[{"type":"benefit","settings":{"title":"Thoughtful delivery","text":"Comfort, delivered to your door."}},{"type":"benefit","settings":{"title":"Made for real life","text":"Beautiful pieces to make yours."}},{"type":"benefit","settings":{"title":"Here to help","text":"Talk to us about your perfect sofa."}}]}]}
{% endschema %}
