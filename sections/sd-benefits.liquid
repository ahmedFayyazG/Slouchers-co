<section class="sd-benefits"><div class="sd-benefits__lead">{{ section.settings.heading | escape }}</div><div class="sd-benefits__grid">{% for block in section.blocks %}<div class="sd-benefits__card" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}{% case forloop.index %}{% when 1 %}<img src="{{ 'reference-benefit-01.png' | asset_url }}" loading="lazy" width="900" height="600" alt="">{% when 2 %}<img src="{{ 'reference-benefit-02.png' | asset_url }}" loading="lazy" width="900" height="600" alt="">{% else %}<img src="{{ 'reference-benefit-03.png' | asset_url }}" loading="lazy" width="900" height="600" alt="">{% endcase %}{% endif %}<h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div>{% endfor %}</div></section>
{% schema %}
{"name":"Service benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"We make finding your favourite seat simple."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"image_picker","id":"image","label":"Illustration"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Description"}]}],"presets":[{"name":"Service benefits","blocks":[{"type":"benefit","settings":{"title":"Thoughtful delivery","text":"Comfort, delivered to your door."}},{"type":"benefit","settings":{"title":"Made for real life","text":"Beautiful pieces to make yours."}},{"type":"benefit","settings":{"title":"Here to help","text":"Talk to us about your perfect sofa."}}]}]}
{% endschema %}
