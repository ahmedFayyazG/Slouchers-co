<section class="sl-editorial sl-section {% if section.settings.split %}sl-editorial--split{% endif %}">
  <div class="sl-editorial__copy"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.body != blank %}<p>{{ section.settings.body | escape }}</p>{% endif %}{% if section.settings.button_label != blank %}<a class="sl-under-link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
  <div class="sl-editorial__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 1000, 1400, 1800', alt: section.settings.image.alt }}{% else %}{{ 'lifestyle-2' | placeholder_svg_tag }}{% endif %}</div>
</section>
{% schema %}
{"name":"Editorial feature","settings":[{"type":"text","id":"heading","label":"Heading","default":"Make room for more living."},{"type":"text","id":"body","label":"Description","default":"A sofa you can stretch out on, gather around and come home to."},{"type":"text","id":"button_label","label":"Link label","default":"Explore modular sofas"},{"type":"url","id":"button_link","label":"Link destination"},{"type":"image_picker","id":"image","label":"Photograph"},{"type":"checkbox","id":"split","label":"Image beside copy","default":false}],"presets":[{"name":"Editorial feature"}]}
{% endschema %}
