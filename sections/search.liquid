<section class="sl-search sl-section"><h1>Search</h1><form action="{{ routes.search_url }}" method="get" role="search"><label for="sl-search-input">Search the shop</label><div><input id="sl-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for sofas" required><button type="submit">Search →</button></div></form>
{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}<div class="sl-collection__grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'sl-product-card', product: item %}{% else %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% endif %}{% endfor %}</div><div class="sl-pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}{% endif %}</section>
{% schema %}
{"name":"Search","settings":[]}
{% endschema %}
