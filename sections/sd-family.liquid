<section class="sd-family"><div class="sd-family__copy"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><a class="sd-outline-button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></div><div class="sd-family__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}{% else %}<img src="{{ 'reference-room-01.jpg' | asset_url }}" loading="lazy" width="1400" height="900" alt="Warm living room">{% endif %}</div></section>
{% schema %}
{"name":"Brand story","settings":[{"type":"text","id":"heading","label":"Heading","default":"A home for every kind of day"},{"type":"textarea","id":"body","label":"Body","default":"A good sofa changes the way a room feels. Find one that makes space for every moment."},{"type":"text","id":"link_label","label":"Link label","default":"Explore the collection"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"image","label":"Photograph"}],"presets":[{"name":"Brand story"}]}
{% endschema %}
