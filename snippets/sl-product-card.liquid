{% doc %}
  Renders the shared product card for collection pages and product rails.
  @param {product} product - Product to render
  @example
  {% render 'sl-product-card', product: product %}
{% enddoc %}
<a class="sl-product-card" href="{{ product.url }}">
  <div class="sl-product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', alt: product.featured_image.alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div>
  <div class="sl-product-card__info"><h3>{{ product.title | escape }}</h3><span>{{ product.price | money }}</span></div>
  {% if product.metafields.custom.fabric != blank %}<p class="sl-product-card__detail">{{ product.metafields.custom.fabric.value | escape }}</p>{% endif %}
</a>
